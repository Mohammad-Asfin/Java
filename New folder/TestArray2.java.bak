class TestArray2 
{
	public static void main(String[] args) 
	{
		int []A = { 10, 20, 30, 40 };
		System.out.println("The given 1st Number:"+A[0]);
		System.out.println("The given 2st Number:"+A[1]);
		System.out.println("The given 3st Number:"+A[2]);
		System.out.println("The given 4st Number:"+A[3]);

		System.out.println("The given Numbers are :(Using Loop)");
		int i;
		for (i = 0;i < 5;i++)
		{
			System.out.print(A[i]+ " ");
		}
		System.out.println("\nThe given Numbers are:");
		for (int t : A) //For Each Loop .........
		{
			System.out.println(t + " ");
		}
	}
}
