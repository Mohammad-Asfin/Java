import java.util.*;
class Matrix2 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner (System.in);

		int [ ][ ]A = new int[3][3];
		int r,c;
		System.out.println("Enter the 3 X 3 Matrix:");
		for ( r = 0; r < 3 ; r++ )
		{
			for ( c = 0 ; c < 3 ; c++ )
			{
				System.out.print("Enter the number (" + r + " , " + c + ") : ");
				A[r][c] = sc.nextInt( );
			}
		}
			System.out.println("The given matrix");
			for ( r = 0 ; r < 3 ; r++ )
			{
				for ( c = 0 ; c < 3 ; c++ )
				{
					System.out.print(A[r][c] + " ");
				}
				System.out.println();
			}
	}
}
